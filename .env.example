# Copy to .env.local for local development. All values are optional - the app is offline-first.

# Base path the app is served from. "/" for local dev and the Android app,
# "/<repo-name>/" for GitHub Pages (set automatically in CI).
VITE_BASE=/

# Optional: URL of a hosted backend for the online-only features (AI generation, cloud history sync,
# e-mail reports). Leave empty for a fully offline build. In CI, set the repository variable
# ZITE_RUNNER_URL instead of committing a value here.
VITE_ZITE_RUNNER_URL=
