# Copy to .env.local for local development. Every value is optional - the app is offline-first.

# Base path the app is served from. "/" for local dev and the Android app,
# "/<repo-name>/" for GitHub Pages (set automatically in CI).
VITE_BASE=/

# Cloud sync + accounts (Supabase). See docs/CLOUD_SETUP.md.
# The publishable (anon) key is meant to be public. NEVER put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional legacy backend for the original hosted AI/e-mail/PDF endpoints. Leave empty: AI works on the
# device with your own key (Settings -> AI), and cloud sync uses Supabase.
VITE_ZITE_RUNNER_URL=
